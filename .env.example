# Обязательно
BOT_TOKEN=123456:ABC-your-token

# Необязательно (значения по умолчанию указаны)
MAX_CONCURRENT_DOWNLOADS=3
MAX_FILE_SIZE_MB=50
MAX_DURATION_SEC=3600
MAX_VIDEO_HEIGHT=720
DOWNLOAD_TIMEOUT_SEC=300
UPLOAD_TIMEOUT_SEC=300
RATE_LIMIT_PER_USER_PER_MIN=5
MAX_ACTIVE_TASKS_PER_USER=1
# TEMP_DIR=/var/tmp/downloader-bot
# Cookies в формате Netscape (cookies.txt) — помогает при «confirm you're not a bot» на YouTube
# и нужен для Instagram: без входа он быстро упирается в лимит анонимных запросов.
# Лучше от отдельного аккаунта: платформа может его ограничить.
# COOKIES_FILE=/opt/downloader-bot/cookies.txt
